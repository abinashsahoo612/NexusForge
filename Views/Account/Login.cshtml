@model TaskManagementSystem.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h2>Welcome Back</h2>
        <p class="subtitle">Login to manage your tasks</p>

        <form asp-action="Login" method="post">

            <div class="form-group">
                <input asp-for="Email" placeholder="Email" class="form-input" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input asp-for="Password" type="password" placeholder="Password" class="form-input" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-options">
                <label>
                    <input asp-for="RememberMe" />
                    Remember Me
                </label>
            </div>

            <button type="submit" class="btn-primary">Login</button>

            <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
        </form>

        <p class="auth-footer">
            Don’t have an account?
            <a asp-action="Register">Register</a>
        </p>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}