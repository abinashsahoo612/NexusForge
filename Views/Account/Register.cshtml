@model TaskManagementSystem.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h2>Create Account</h2>
        <p class="subtitle">Start managing your tasks</p>

        <form asp-action="Register" method="post">

            <div class="form-group">
                <input asp-for="Email" placeholder="Email" class="form-input" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input asp-for="Password" type="password" placeholder="Password" class="form-input" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" class="form-input" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="auth-btn-primary">Register</button>
        </form>

        <p class="auth-footer">
            Already have an account?
            <a asp-action="Login">Login</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}