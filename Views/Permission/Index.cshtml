@model TaskManagementSystem.DTOs.Permissions.PermissionManagementDto

@using TaskManagementSystem.Enums.Workspaces

@{
    ViewData["Title"] = "Manage Permissions";
    var workspaceId = (int)ViewBag.WorkspaceId;
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                Manage Permissions
            </h3>

            <p class="text-muted mb-0">
                Control what each workspace role can do.
            </p>
        </div>

        <a asp-controller="Workspace"
           asp-action="Details"
           asp-route-id="@workspaceId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle"></i>
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-1 fw-bold">
                        @Model.Role Permissions
                    </h5>

                    <small class="text-muted">
                        Select the actions allowed for this role.
                    </small>
                </div>

                <div>
                    <span class="badge bg-primary">
                        @Model.Role
                    </span>
                </div>

            </div>

        </div>

        <div class="card-body">

            <!-- Role Selection -->

            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Workspace Role
                </label>

                <select class="form-select"
                        onchange="changeRole(this.value)">

                    @foreach (var role in Enum.GetValues<WorkspaceRole>())
                    {
                        <option value="@role"
                                selected="@(role == Model.Role)">
                            @role
                        </option>
                    }

                </select>

            </div>

            <form asp-action="Save"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="workspaceId"
                       value="@workspaceId" />

                <input type="hidden"
                       name="role"
                       value="@Model.Role" />

                <div class="row g-3">

                    @foreach (var permission in Model.Permissions)
                    {
                        var isSelected =
                            Model.SelectedPermissionIds
                                .Contains(permission.Id);

                        <div class="col-md-6">

                            <div class="border rounded p-3">

                                <div class="form-check">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="permissionIds"
                                           value="@permission.Id"
                                           id="permission_@permission.Id"
                                           checked="@isSelected" />

                                    <label class="form-check-label fw-semibold"
                                           for="permission_@permission.Id">

                                        @permission.Name

                                    </label>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    permission.Description))
                                {
                                    <small class="text-muted ms-4">
                                        @permission.Description
                                    </small>
                                }

                            </div>

                        </div>
                    }

                </div>

                <div class="d-flex justify-content-end mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>
                        Save Permissions

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        function changeRole(role) {

            const workspaceId = '@workspaceId';

            window.location.href =
                '@Url.Action("Index", "Permission")' +
                '?workspaceId=' +
                workspaceId +
                '&role=' +
                role;
        }

    </script>
}