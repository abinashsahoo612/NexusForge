@using TaskManagementSystem.Enums.Workspaces
@model IEnumerable<TaskManagementSystem.DTOs.Workspaces.WorkspaceListItemDto>

@{
    ViewData["Title"] = "Workspaces";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Workspaces</h2>

    @* <a asp-action="Create" class="btn btn-sm btn-info">
        Create Workspace
    </a> *@
    <button id="workspaceCreate"
    class="btn btn-info">
        Create
    </button>
</div>

<table class="table table-bordered table-striped table-hover">

    <thead class="table-light">

        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Members</th>
            <th>Policy</th>
            <th>Role</th>
            <th>Status</th>
            <th width="150">Action</th>
        </tr>

    </thead>

    <tbody>

    @if (Model.Any())
    {
        @foreach (var workspace in Model)
        {
            <tr>

                <td>@workspace.Name</td>

                <td>@workspace.Description</td>

                <td>@workspace.MemberCount</td>

                <td>@workspace.MembershipPolicy</td>

                <td>@workspace.MyRole</td>

                <td>
                    @(workspace.IsActive ? "Active" : "Inactive")
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@workspace.Id"
                       class="btn btn-sm btn-info">
                        View
                    </a>

                    @if (workspace.MyRole == WorkspaceRole.Admin)
                    {
                        <button id="workspaceEdit"
                        data-id = "@workspace.Id"
                        class="btn btn-warning btn-sm">
                            Edit
                        </button>
                    }

                </td>

            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="7" class="text-center">
                No workspaces found.
            </td>
        </tr>
    }

    </tbody>

</table>

<div class="modal fade" id="workspaceModal" tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content" id="workspaceModalContent">

        </div>

    </div>

</div>