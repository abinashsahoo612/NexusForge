@model TaskManagementSystem.ViewModels.Task.TaskSectionViewModel

<div class="card mb-6">

    <div class="card-header">
        <div class="d-flex justify-content-between">
            <strong class="my-2">Unassigned Tasks</strong>
            <button class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#addTaskModal">

                <i class="bi bi-folder-plus"></i>
                Add Task

            </button>
        </div>
    </div>

    <div class="card-body p-2">

        @* <table class="table table-striped table-hover mb-0"> *@
        <table class="table table-striped table-hover" id="unassignedTaskListTable">

            <thead class="table-light">

                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Created By</th>
                </tr>

            </thead>

            <tbody>
                @foreach (var unassignedTaskItem in Model.UnassignedTasks)
                {
                    <tr>

                        <td>@unassignedTaskItem.Title</td>

                        <td>@unassignedTaskItem.Description</td>

                        <td>@unassignedTaskItem.Status</td>
                        
                        <td>@unassignedTaskItem.Priority</td>

                        <td>@unassignedTaskItem.CreatedBy</td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="modal fade"
     id="addTaskModal"
     tabindex="-1"
     aria-labelledby="addTaskModalLabel"
     aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content border-0 shadow-lg rounded-4">

                <div class="modal-header bg-primary text-white">

                    <h5 class="modal-title fw-semibold" id="addTaskModalLabel">
                        <i class="bi bi-list-task me-2"></i>
                        Create New Task
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>

                </div>
                <form id="addTaskForm"
                            asp-controller="Workspace"
                            asp-action="CreateTask"
                            method="post">
                <div class="modal-body">
                    @Html.AntiForgeryToken()

                    <!-- Project -->   

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            <i class="bi bi-folder2-open me-1"></i>
                            Project
                        </label>

                        <select class="form-select" name="ProjectId" id="ProjectId">
                            <option value="">-- Select Project --</option>
                            @foreach (var item in Model.Projects)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>

                    </div>

                    <!-- Task Title -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            <i class="bi bi-pencil-square me-1"></i>
                            Task Title
                        </label>

                        <input type="text"
                            class="form-control"
                            id="Title"
                            name="Title"
                            maxlength="200"
                            placeholder="Enter task title" />

                    </div>

                    <!-- Description -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            <i class="bi bi-card-text me-1"></i>
                            Description
                        </label>

                        <textarea class="form-control"
                                id="Description"
                                name="Description"
                                rows="4"
                                placeholder="Describe the task..."></textarea>

                    </div>

                    <!-- Status & Priority -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    <i class="bi bi-flag me-1"></i>
                                    Status
                                </label>

                                <select class="form-select" name="Status" id="Status">

                                    <option value="">-- Select Status --</option>

                                    @foreach (var status in Enum.GetValues<TaskManagementSystem.Enums.Task.TaskStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }

                                </select>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    <i class="bi bi-exclamation-circle me-1"></i>
                                    Priority
                                </label>

                                <select class="form-select" name="Priority" id="Priority">

                                    <option value="">-- Select Priority --</option>

                                    @foreach (var priority in Enum.GetValues<TaskManagementSystem.Enums.Task.TaskPriority>())
                                    {
                                        <option value="@priority">@priority</option>
                                    }

                                </select>

                            </div>

                        </div>

                    </div>

                    <!-- Future Ready -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    Due Date
                                </label>

                                <input type="date"
                                    class="form-control"
                                    namr="DueDate"
                                    id="DueDate" />

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    <i class="bi bi-person me-1"></i>
                                    Assign To
                                </label>

                                <select class="form-select" name="AssignedUserId" id="AssignedUserId">
                                    <option value="">-- Unassigned --</option>
                                    @foreach (var item in Model.Users)
                                    {
                                        <option value="@item.Id">@item.FullName (@item.Email)</option>
                                    }
                                </select>

                            </div>

                        </div>

                    </div>
                </div>

                <div class="modal-footer bg-light rounded-bottom-4">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancel

                    </button>

                    <button type="button"
                            class="btn btn-primary px-4"
                            id="saveTask">

                        <i class="bi bi-check-circle me-1"></i>
                        Create Task

                    </button>

                </div>
                </form>
            </div>

        </div>

    </div>
</div>