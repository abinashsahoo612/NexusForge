@model TaskManagementSystem.DTOs.Workspaces.WorkspaceDetailsDto

@{
    ViewData["Title"] = "Workspace Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Workspace Details</h3>

        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>
    </div>
    <div class="row justify-content-between ">
        <div class="col-xl-4 col-lg-4">
            <partial name="Partials/_WorkspaceInfo" model="Model" />
        </div>
        <div class="col-xl-8 col-lg-8">
            <partial name="Partials/_AddMember" model="Model.AllUser"/>
        </div>
    </div>

    <hr class="my-4" />

    <partial name="Partials/_WorkspaceMembers" model="Model.Members" />

    <hr class="my-4" />
    
    <partial name="Partials/_ProjectList" model="Model.ProjectList" />

</div>