@model TaskManagementSystem.DTOs.Task.UpdateTaskDto

<div class="modal-header bg-success text-white">

    <h5 class="modal-title fw-semibold">
        <i class="bi bi-pencil-square me-2"></i>
        Edit Task
    </h5>

    <button type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="modal">
    </button>

</div>

<form id="editTaskForm"
      asp-controller="Task"
      asp-action="Update"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />
    <input asp-for="WorkspaceId" type="hidden" />

    <div class="modal-body">

        <!-- Project -->

        <div class="mb-3">

            <label asp-for="ProjectId" class="form-label fw-semibold">
                <i class="bi bi-folder2-open me-1"></i>
                Project
            </label>

            <select asp-for="ProjectId" class="form-select">

                <option value="">-- Select Project --</option>

                @foreach (var project in Model.ProjectList)
                {
                    <option value="@project.Id">@project.Name</option>
                }

            </select>

        </div>

        <!-- Title -->

        <div class="mb-3">

            <label asp-for="Title" class="form-label fw-semibold">
                <i class="bi bi-pencil-square me-1"></i>
                Task Title
            </label>

            <input asp-for="Title"
                   class="form-control"
                   placeholder="Enter task title" />

        </div>

        <!-- Description -->

        <div class="mb-3">

            <label asp-for="Description" class="form-label fw-semibold">
                <i class="bi bi-card-text me-1"></i>
                Description
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      placeholder="Describe the task..."></textarea>

        </div>

        <!-- Status & Priority -->

        <div class="row">

            <div class="col-md-6">

                <div class="mb-3">

                    <label asp-for="Status" class="form-label fw-semibold">
                        <i class="bi bi-flag me-1"></i>
                        Status
                    </label>

                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<TaskManagementSystem.Enums.Task.TaskStatus>()"
                            class="form-select">
                    </select>

                </div>

            </div>

            <div class="col-md-6">

                <div class="mb-3">

                    <label asp-for="Priority" class="form-label fw-semibold">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        Priority
                    </label>

                    <select asp-for="Priority"
                            asp-items="Html.GetEnumSelectList<TaskManagementSystem.Enums.Task.TaskPriority>()"
                            class="form-select">
                    </select>

                </div>

            </div>

        </div>

        <!-- Due Date & Assign -->

        <div class="row">

            <div class="col-md-6">

                <div class="mb-3">

                    <label asp-for="DueDate" class="form-label fw-semibold">
                        <i class="bi bi-calendar-event me-1"></i>
                        Due Date
                    </label>

                    <input asp-for="DueDate"
                           type="date"
                           class="form-control" />

                </div>

            </div>

            <div class="col-md-6">

                <select asp-for="AssignedToUserId" class="form-select">

                    <option value="">-- Unassigned --</option>

                    @foreach (var user in Model.UserList)
                    {
                        <option value="@user.Id">
                            @user.FullName (@user.Email)
                        </option>
                    }

                </select>

            </div>

        </div>

    </div>

    <div class="modal-footer bg-light rounded-bottom-4">

        <button type="button"
                class="btn btn-outline-secondary"
                data-bs-dismiss="modal">

            <i class="bi bi-x-circle me-1"></i>
            Cancel

        </button>

        <button type="button"
                id="updateTask"
                class="btn btn-success px-4">

            <i class="bi bi-check-circle me-1"></i>
            Update Task

        </button>

    </div>

</form>