@model TaskManagementSystem.DTOs.Task.TaskListDto

<h2>Tasks</h2>

<p>Total : @Model.TotalTasks</p>

<div class="btn-group mb-3">

    <button id="listViewBtn" class="btn btn-primary">
        <i class="bi bi-list-ul"></i> List
    </button>

    <button id="boardViewBtn" class="btn btn-outline-primary">
        <i class="bi bi-kanban"></i> Board
    </button>

</div>

<div id="listView">

    <partial name="Partials/_ListBoard" model="Model" />

</div>

<div id="boardView" style="display:none;">

    <partial name="Partials/_KanbanBoard" model="Model" />

</div>

