@model TaskManagementSystem.DTOs.Task.TaskDetailsDto

@{
    ViewData["Title"] = "Task Details";
}

<div class="container-fluid py-4">

    <div class="row">

        <!-- Left Section -->
        <div class="col-lg-8">

            <!-- Header -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h3 class="mb-1">
                                @Model.Title
                            </h3>

                            <small class="text-muted">
                                Task #@Model.Id
                            </small>

                        </div>

                        <div>

                            <span class="badge bg-primary fs-6">
                                @Model.Status
                            </span>

                            <span class="badge bg-warning text-dark fs-6 ms-2">
                                @Model.Priority
                            </span>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Description -->
            <div class="card shadow-sm mb-4">

                <div class="card-header">

                    <h5 class="mb-0">
                        Description
                    </h5>

                </div>

                <div class="card-body">

                    @if (string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <span class="text-muted">
                            No description available.
                        </span>
                    }
                    else
                    {
                        <p class="mb-0">
                            @Model.Description
                        </p>
                    }

                </div>

            </div>

            <!-- Comments Placeholder -->
            <div class="card shadow-sm mb-4">

                <div class="card-header">

                    <h5 class="mb-0">
                        Comments
                    </h5>

                </div>

                <div class="card-body text-center py-5">

                    <i class="bi bi-chat-left-text display-5 text-secondary"></i>

                    <p class="mt-3 text-muted">
                        Comments module coming soon.
                    </p>

                </div>

            </div>

            <!-- Activity Placeholder -->
            <div class="card shadow-sm">

                <div class="card-header">

                    <h5 class="mb-0">
                        Activity Timeline
                    </h5>

                </div>

                <div class="card-body text-center py-5">

                    <i class="bi bi-clock-history display-5 text-secondary"></i>

                    <p class="mt-3 text-muted">
                        Activity tracking coming soon.
                    </p>

                </div>

            </div>

        </div>

        <!-- Right Sidebar -->
        <div class="col-lg-4">

            <div class="card shadow-sm">

                <div class="card-header">

                    <h5 class="mb-0">
                        Task Information
                    </h5>

                </div>

                <div class="card-body">

                    <table class="table table-borderless mb-0">

                        <tr>
                            <th>Workspace</th>
                            <td>@Model.WorkspaceName</td>
                        </tr>

                        <tr>
                            <th>Project</th>
                            <td>@Model.ProjectName</td>
                        </tr>

                        <tr>
                            <th>Assigned To</th>
                            <td>
                                @(string.IsNullOrWhiteSpace(Model.AssignedToName)
                                    ? "Unassigned"
                                    : Model.AssignedToName)
                            </td>
                        </tr>

                        <tr>
                            <th>Created By</th>
                            <td>@Model.CreatedByName</td>
                        </tr>

                        <tr>
                            <th>Due Date</th>
                            <td>
                                @(Model.DueDate?.ToString("dd MMM yyyy") ?? "-")
                            </td>
                        </tr>

                        <tr>
                            <th>Created</th>
                            <td>@Model.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>

                        <tr>
                            <th>Updated</th>
                            <td>
                                @(Model.UpdatedAt?.ToString("dd MMM yyyy") ?? "-")
                            </td>
                        </tr>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>